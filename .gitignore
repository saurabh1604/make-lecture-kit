*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# Python
__pycache__/
*.pyc

# OS / editor
.DS_Store

# Local package builds (students update via the repo's auto-zip, not these)
make-lecture-kit.zip
make-lecture-kit.skill
make-lecture-kit-UPGRADED.zip
